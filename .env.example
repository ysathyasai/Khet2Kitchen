# Django Settings
SECRET_KEY=django-insecure-k2k-change-me-in-production-agricultural-supply-chain
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database URL
# Format for Neon PostgreSQL (Production/Staging): postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
# Format for SQLite (Local development default): sqlite:///db.sqlite3
DATABASE_URL=sqlite:///db.sqlite3

# Firebase Admin SDK (Optional override path; defaults to firebase-credentials.json in project root)
# FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Hybrid Vernacular Voice Assistant Settings
# Sarvam AI API Key (STT & TTS)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_BASE_URL=https://api.sarvam.ai

# Google Gemini API Key (Intent Reasoning & Vernacular Generation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.6-flash

