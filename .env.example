# Django Settings
SECRET_KEY=django-insecure-k2k-change-me-in-production-agricultural-supply-chain
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Database URL
# Format for Render MySQL: mysql://<user>:<password>@<host>:<port>/<dbname>
# Example: mysql://k2k_user:secret_pass@mysql.render.com:3306/k2k_db
DATABASE_URL=sqlite:///db.sqlite3

# Hybrid Vernacular Voice Assistant Settings
# Sarvam AI API Key (STT & TTS)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_API_BASE_URL=https://api.sarvam.ai

# Google Gemini API Key (Intent Reasoning & Vernacular Generation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.6-flash

